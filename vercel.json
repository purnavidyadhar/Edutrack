{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.6.2"
    }
  },
  "routes": [
    { "src": "/build/(.*)", "dest": "/build/$1" },
    { "src": "^/(favicon\\.ico|robots\\.txt|css/.*|js/.*|images/.*)$", "dest": "/$1" },
    { "src": "^/(.*\\.(js|css|png|jpg|jpeg|svg|ico|json|webmanifest|map|woff2?))$", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
